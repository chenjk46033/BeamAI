# The export the app writes on Confirm, overwritten every session.
# The stable parity input is testdata/beamai_fiducials_F040_T1_MRI.csv.
/beamai_fiducials.csv

# The de-identified MRI fixture the parity overlay renders on. Written by
# apps/make_mri_fixture from the original DICOM series; carries geometry and
# voxels only -- no patient, physician, study, or date fields.
!/testdata/beamai_F040_T1_MRI.nii
